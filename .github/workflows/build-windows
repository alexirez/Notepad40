name: Build Windows

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '10.0.x'

      - name: Install MAUI Windows workload
        run: dotnet workload install maui-windows

      - name: Restore
        run: dotnet restore Notepad40/Notepad40.csproj -p:TargetFramework=net10.0-windows10.0.19041.0

      - name: Build Windows app
        run: dotnet publish Notepad40/Notepad40.csproj -f net10.0-windows10.0.19041.0 -c Release --no-restore -o ./publish-windows

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: notepad40-windows
          path: ./publish-windows
