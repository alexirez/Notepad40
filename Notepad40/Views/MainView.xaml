<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:models="clr-namespace:Notepad40.Models"
    xmlns:viewModels="clr-namespace:Notepad40.ViewModels"
    x:Class="Notepad40.Views.MainView"
    x:Name="Root"
    x:DataType="viewModels:MainViewModel">

    <Grid>

        <!-- Background Layer -->
        <Image
            Source="vecteezy_wood_background.jpg"
            Aspect="AspectFill"
            Opacity="1" />

        <!-- MAIN LAYOUT -->
        <Grid RowDefinitions="Auto,*" ColumnDefinitions="220,*">

            <!-- TOOLBAR -->
            <Grid
                Grid.ColumnSpan="2"
                ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                Padding="12">

                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#3E1F00" Offset="0.0" />
                        <GradientStop Color="#6B3A1F" Offset="0.5" />
                        <GradientStop Color="#3E1F00" Offset="1.0" />
                    </LinearGradientBrush>
                </Grid.Background>

                <Label
                    Text="Notepad40"
                    TextColor="White"
                    FontAttributes="Bold"
                    VerticalOptions="Center" />

                <Button
                    Grid.Column="1"
                    Text="New"
                    TextColor="#3E1F00"
                    BackgroundColor="#F5ECD7"
                    CornerRadius="8"
                    Command="{Binding NewNoteCommand}" />

                <Button
                    Grid.Column="2"
                    Text="Save"
                    TextColor="#3E1F00"
                    BackgroundColor="#F5ECD7"
                    CornerRadius="8"
                    Command="{Binding SaveNoteCommand}" />

                <Button
                    Grid.Column="3"
                    Text="Delete"
                    TextColor="#3E1F00"
                    BackgroundColor="#F5ECD7"
                    CornerRadius="8"
                    Command="{Binding DeleteNoteCommand}" />

                <Button
                    Grid.Column="4"
                    Text="Settings"
                    TextColor="#3E1F00"
                    BackgroundColor="#F5ECD7"
                    CornerRadius="8"
                    Command="{Binding OpenSettingsCommand}" />
            </Grid>

            <!-- LEFT PANEL -->
            <Grid Grid.Row="1" Grid.Column="0">

                <!-- Just reuse Image like the main background -->
                <Image
                    Source="magnific_light_planks.jpg"
                    Aspect="AspectFill"
                    Opacity="1" />

                <CollectionView
                    ItemsSource="{Binding Notes}"
                    SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                    SelectionMode="Single"
                    BackgroundColor="Transparent">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Note">
                            <Border
                                Padding="10"
                                BackgroundColor="Transparent"
                                Margin="4"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24" />
                                </Border.StrokeShape>
                                <Label
                                    Text="{Binding Content}"
                                    TextColor="White"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </Grid>

            <!-- RIGHT PANEL -->
            <Grid Grid.Row="1" Grid.Column="1" Padding="12">
                <Editor
                    Placeholder="Write your note..."
                    Text="{Binding NoteText, Mode=TwoWay}"
                    AutoSize="TextChanges"
                    BackgroundColor="Transparent"
                    TextColor="White" />
            </Grid>

        </Grid>
    </Grid>

</ContentPage>