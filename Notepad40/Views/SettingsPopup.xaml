<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:models="clr-namespace:Notepad40.Models"
    xmlns:viewModels="clr-namespace:Notepad40.ViewModels"
    x:Class="Notepad40.Views.SettingsPopup"
    x:DataType="viewModels:SettingsViewModel"
    Padding="0"
    Margin="14">

    <Border
        BackgroundColor="#2E2E2E"
        Padding="8"
        StrokeShape="RoundRectangle 18"
        WidthRequest="400"
        HeightRequest="1000"
        HorizontalOptions="Center"
        VerticalOptions="Center">

        <!-- Settings options -->
        <VerticalStackLayout Spacing="20" HorizontalOptions="Center">

            <Label
                Text="Settings"
                FontFamily="{Binding FontFamily}"
                TextColor="White"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                Margin="0,8,0,8"/>

            <!-- Font Size Row -->
            <HorizontalStackLayout VerticalOptions="Center" HorizontalOptions="Fill" Spacing="10">
                
                <Label
                    Text="Font size"
                    FontFamily="{Binding FontFamily}"
                    TextColor="White"
                    VerticalOptions="Center"
                    WidthRequest="80"/>
                
                <!-- Decrease Button -->
                <Button
                    Text="-"
                    Command="{Binding DecreaseFontSizeCommand}"
                    WidthRequest="40"
                    HeightRequest="40"
                    FontSize="{Binding FontSize}"
                    FontFamily="{Binding FontFamily}"
                    BackgroundColor="#444"
                    TextColor="White"
                    Pressed="OnButtonPressed"
                    Released="OnButtonReleased"/>
                
                <!-- Textbox -->
                <Entry
                    Text="{Binding FontSizeText, Mode=TwoWay}"
                    FontFamily="{Binding FontFamily}"
                    Keyboard="Numeric"
                    Unfocused="OnFontSizeUnfocused"
                    HorizontalTextAlignment="Center"
                    WidthRequest="80"
                    HeightRequest="40"
                    BackgroundColor="#3A3A3A"
                    TextColor="White"
                    Completed="OnFontSizeCompleted"/>
                
                <!-- Increase Button -->
                <Button
                    Text="+"
                    FontFamily="{Binding FontFamily}"
                    Command="{Binding IncreaseFontSizeCommand}"
                    WidthRequest="40"
                    HeightRequest="40"
                    FontSize="{Binding FontSize}"
                    BackgroundColor="#444"
                    TextColor="White"
                    Pressed="OnButtonPressed"
                    Released="OnButtonReleased"/>
            </HorizontalStackLayout>

            <Picker
                TextColor="White"
                BackgroundColor="#3A3A3A"
                WidthRequest="160"
                VerticalOptions="Center"
                SelectedItem="{Binding FontFamily, Mode=TwoWay}">
                <Picker.Items>
                    <x:String>Default</x:String>
                    <x:String>Consolas</x:String>
                    <x:String>Courier New</x:String>
                </Picker.Items>
            </Picker>

            <!-- Space separator -->
            <BoxView
                HeightRequest="1"
                BackgroundColor="#444"
                HorizontalOptions="Fill"
                Margin="0,8,0,8"/>

             <!-- Close Settings Button -->
             <Button
                Text="Close"
                WidthRequest="100"
                HeightRequest="40"
                BackgroundColor="#444"
                TextColor="White"
                Clicked="OnCloseClicked"
                Pressed="OnButtonPressed"
                Released="OnButtonReleased"/>

        </VerticalStackLayout>

    </Border>
</toolkit:Popup>
