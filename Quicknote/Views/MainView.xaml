<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:models="clr-namespace:Quicknote.Models"
    xmlns:viewModels="clr-namespace:Quicknote.ViewModels"
    x:Class="Quicknote.Views.MainView"
    x:DataType="viewModels:MainViewModel">

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="220,*">

        <!-- Toolbar -->
        <Grid
            Grid.ColumnSpan="2"
            ColumnDefinitions="*,Auto,Auto,Auto"
            BackgroundColor="#222"
            Padding="12">

            <!-- Logo -->
            <Label
                Text="Quicknote"
                TextColor="White"
                VerticalOptions="Center" />

            <!-- Some buttons -->
            <Button
                Grid.Column="1"
                Text="New"
                Command="{Binding NewNoteCommand}"
                MinimumWidthRequest="40"
                VerticalOptions="Center"
                Margin="3,3,3,3"/>

            <Button
                Grid.Column ="2"
                Text="Save"
                Command="{Binding SaveNoteCommand}"
                MinimumWidthRequest="40"
                VerticalOptions="Center"
                Margin="3,3,3,3"/>

            <Button
                Grid.Column="3"
                Text="Delete"
                Command="{Binding DeleteNoteCommand}"
                MinimumWidthRequest="40"
                VerticalOptions="Center"
                Margin="3,3,3,3"/>
        </Grid>

        <!-- Notes list -->
        <CollectionView
            Grid.Row="1"
            BackgroundColor="#1E1E1E"
            ItemsSource="{Binding Notes}"
            SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
            SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Note">
                    <Border
                        Padding="10"
                        BackgroundColor="Transparent"
                        StrokeThickness="1"
                        Stroke="Transparent"
                        Margin="4">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">

                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#2B2B2B" />
                                    </VisualState.Setters>
                                </VisualState>

                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Label
                            Text="{Binding Content}"
                            Padding="10"
                            LineBreakMode="TailTruncation"
                            MaxLines="1"
                            FontSize="14"
                            TextColor="White" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Editor -->
        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Padding="12">
            <Editor
                Placeholder="Write your note..."
                Text="{Binding NoteText, Mode=TwoWay}"
                AutoSize="TextChanges"
                BackgroundColor="#2E2E2E"
                TextColor="White"
                Margin="0,0,0,12"/>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
