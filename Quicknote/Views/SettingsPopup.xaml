<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="Quicknote.Views.SettingsPopup">

    <Border
        BackgroundColor="#2E2E2E"
        Padding="20"
        StrokeShape="RoundRectangle 24"
        WidthRequest="400"
        HeightRequest="500">

        <!-- Settings options -->
        <VerticalStackLayout Spacing="20">

            <!-- Font Size Row -->
            <HorizontalStackLayout VerticalOptions="Center" HorizontalOptions="Fill" Spacing="10">
                
                <Label
                    Text="Font size"
                    TextColor="White"
                    VerticalOptions="Center"
                    WidthRequest="80"/>
                
                <!-- Decrease Button -->
                <Button
                    Text="-"
                    WidthRequest="40"
                    HeightRequest="40"
                    FontSize="18"
                    BackgroundColor="#444"
                    TextColor="White"/>
                
                <!-- Textbox -->
                <Entry
                    Text="14"
                    Keyboard="Numeric"
                    HorizontalTextAlignment="Center"
                    WidthRequest="80"
                    HeightRequest="40"
                    BackgroundColor="#3A3A3A"
                    TextColor="White"/>
                
                <!-- Increase Button -->
                <Button
                    Text="+"
                    WidthRequest="40"
                    HeightRequest="40"
                    FontSize="18"
                    BackgroundColor="#444"
                    TextColor="White"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>

    </Border>
</toolkit:Popup>
